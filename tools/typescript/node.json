{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    /* Runtime target — matches .nvmrc */
    "target": "ES2024",
    "lib": ["ES2024"],

    /* Module system (Node ESM/CJS interop) */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* Module hygiene */
    "verbatimModuleSyntax": true
  }
}
