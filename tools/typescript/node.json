{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    /* Runtime target — matches .nvmrc */
    "target": "ES2024",
    "lib": ["ES2024"],

    /* Module system — bundler resolution lets tsx/Vite/esbuild handle extension-less imports */
    "module": "ESNext",
    "moduleResolution": "bundler",

    /* Module hygiene */
    "verbatimModuleSyntax": true
  }
}
