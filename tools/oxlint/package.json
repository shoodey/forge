{
  "name": "@forge/oxlint-config",
  "version": "0.1.0",
  "files": [
    "config",
    "oxlint.config.ts"
  ],
  "type": "module",
  "exports": {
    "./base": "./config/base.ts",
    "./node": "./config/node.ts"
  },
  "scripts": {
    "format": "oxfmt --check --config ../oxfmt/oxfmt.config.ts",
    "format:fix": "oxfmt --config ../oxfmt/oxfmt.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@forge/tsconfig": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  }
}
