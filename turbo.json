{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "check": {
      "dependsOn": ["format", "typecheck"]
    },
    "check:fix": {
      "dependsOn": ["format:fix"]
    },
    "format": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/oxfmt/oxfmt.config.ts"],
      "outputs": []
    },
    "format:fix": {
      "cache": false
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/typescript/*.json"],
      "outputs": ["node_modules/.cache/tsbuildinfo.json"]
    }
  }
}
