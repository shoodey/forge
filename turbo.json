{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "check": {
      "dependsOn": ["format", "typecheck", "lint"]
    },
    "check:fix": {
      "dependsOn": ["format:fix", "lint:fix"]
    },
    "format": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/oxfmt/oxfmt.config.ts"],
      "outputs": []
    },
    "format:fix": {
      "cache": false
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/typescript/*.json"],
      "outputs": ["node_modules/.cache/tsbuildinfo.json"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/oxlint/config/*.ts", "$TURBO_ROOT$/tools/oxlint/package.json"],
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    }
  }
}
